# /etc/config/m3u8mc
# m3u8mc 插件 UCI 配置文件
# 修改后执行 service m3u8mc reload 即可热加载，无需重启

# ── 全局配置 ──────────────────────────────────────────────────
config global
    option enabled          '1'
    option log_level        'warning'
    # 控制 socket 路径；m3u8mcctl 默认值与此保持一致
    option control_socket   '/var/run/m3u8mcd.sock'
    # 内部 HTTP 起始端口；频道按此递增自动分配
    option http_port_base   '18080'
    # 自定义 ffmpeg 路径；留空则用系统 PATH 中的 ffmpeg
    # option ffmpeg_bin      '/usr/local/bin/ffmpeg'

# ── 频道（完整的参数列表）─────────────────────────────────────
# 复制本节并修改 section name 来添加新频道
# 所有带「默认 X」标记的字段可省略
# config channel 'cctv5'
#     # ── 基础 ────────────────────────────────────────────────
#     option enabled          '1'
#     option name             'CCTV-5 体育'
#     # 镜像源地址（可多条），直通模式只允许单条
#     list   url              'http://mirror1.example.com/playlist.m3u8'
#     # list url              'http://mirror2.example.com/playlist.m3u8'
#     # 推流协议：rtp / udp
#     option protocol         'rtp'
#     # 组播地址
#     option addr             '239.255.1.1'
#     # 组播端口
#     option port             '1234'
#     # 出口接口名或本机 IP（留空=不设 localaddr，系统自动选路）
#     # option iface           'lan'
#
#     # ── 运行模式 ────────────────────────────────────────────
#     # 1=标准模式（下载→缓存→内部 HTTP→ffmpeg）
#     # 0=直通模式（ffmpeg 直接拉上游，仅支持单源）
#     option use_downloader   '1'         # 默认 1
#     # 1=赛马模式（多源并发竞速取最快）
#     # option race_mode       '0'         # 默认 0
#     # 赛马候选 IP（可用 @ 指定专属域名，如 1.2.3.4@cdn.example.com）
#     # list race_ip           '1.2.3.4'
#     # option race_host       ''          # 全局赛马 Host
#
#     # ── 下载/缓存调优 ───────────────────────────────────────
#     # option threads          '4'         # 分块下载并发数（默认 4）
#     # option cache_window     '3'         # 缓存时间窗口（分片时长×倍数，默认 3）
#     # option max_segments     '5'         # 缓存分片数上限（默认 5）
#     # option hls_segments     '3'         # 内部 m3u8 滑动窗口（默认 3）
#
#     # ── 内部 HTTP ──────────────────────────────────────────
#     # option http_port        ''          # 留空自动分配
#     # option http_path        '/live'     # HTTP 路径前缀（默认 /live）
#
#     # ── HTTP 请求头 ─────────────────────────────────────────
#     # 公共请求头（Poller + Downloader 均携带）
#     # list http_header        'User-Agent: Mozilla/5.0'
#     # 仅 Poller 携带（覆盖公共头）
#     # list poller_http_header 'Referer: https://example.com'
#     # 仅 Downloader 携带（覆盖公共头）
#     # list downloader_http_header 'Cookie: session=xxx'
#
#     # ── 列表拉取独立配置 ────────────────────────────────────
#     # 列表与分片走不同源时配置此项
#     # list list_url           'http://list-origin.com/playlist.m3u8'
#     # option list_poll_interval_secs '3.0'  # 列表轮询间隔（默认自动）
#
#     # ── 代理 ────────────────────────────────────────────────
#     # option list_proxy       'http://127.0.0.1:10809'
#     # option download_proxy   'http://127.0.0.1:10809'
#
#     # ── 推流参数 ────────────────────────────────────────────
#     # option ttl              '4'         # 组播 TTL（默认 4）
#     # option pkt_size         '1316'      # UDP 包大小（默认 1316）
#     # option buffer_size      '1048576'   # 推流缓冲区（默认 1MB）
#
#     # ── ffmpeg 参数 ─────────────────────────────────────────
#     # 输入参数（-i 之前）
#     # list ffmpeg_input_arg   '-re'
#     # list ffmpeg_input_arg   '-f'
#     # list ffmpeg_input_arg   'hls'
#     # 输出参数（-i 之后、-f mpegts 之前）
#     # list ffmpeg_output_arg  '-pcr_period'
#     # list ffmpeg_output_arg  '20'
#     # list ffmpeg_output_arg  '-muxdelay'
#     # list ffmpeg_output_arg  '0.7'

# ── 网络隔离（可选）─────────────────────────────────────────────
# config vlan_isolation
#     option enabled          '0'
#     option base_device      'br-lan'
#     option vlan_id          '100'
#     option ipaddr           '10.10.100.1'
#     option netmask          '255.255.255.0'
