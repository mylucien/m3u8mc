# /etc/config/m3u8mc
#
# m3u8mcd 完整配置示例：把 HTTP 单播 m3u8 直播源（支持多镜像）拉流、缓存，
# 转换为 UDP/RTP 组播推送到局域网。
#
# 格式说明（UCI 风格）：
#   - option  字段名 '值'      → 单值字段
#   - list    字段名 '值'      → 可重复的多值字段（比如多个 url / http_header）
#   - 每个 config 段落是独立的一个 section，channel 段的引号里是频道唯一 ID
#
# 只有两类 section：
#   config global            全局设置，只能有一个
#   config channel 'xxx'     一路直播频道，可以有多个

# ============================================================
# 全局设置
# ============================================================
config global
    # 总开关。设为 0 时 daemon 进程正常启动、监听控制 socket，
    # 但不会自动拉起任何频道（可以后续手动 channel_start 单个频道）。
    option enabled '1'

    # 日志级别：trace / debug / info / warning / error
    option log_level 'info'

    # 控制 socket 路径，m3u8mcctl 通过它跟 daemon 通信（reload/status/start/stop 等）
    option control_socket '/var/run/m3u8mcd.sock'

    # 频道没有手动指定 http_port 时，从这个端口开始自动往后找空闲端口分配
    option http_port_base '18080'

    # 优先使用的 ffmpeg 可执行文件路径。
    # 留空 → 从系统 PATH 里找 ffmpeg；
    # 非空 → 直接用这个路径（比如用完整功能版本 /usr/local/bin/ffmpeg-full）
    option ffmpeg_bin ''

    # 磁盘缓存的根目录（仅 cache_storage=disk 的频道使用，各频道在其下用频道 ID 建子目录）。
    # 注意：OpenWrt（含 x86）的 /tmp 通常是内存盘（tmpfs），放那里不省内存；
    # 想真正省内存请指向 USB/SD/硬盘挂载点，如 /mnt/sda1/m3u8mc。
    # 目录实际落在 tmpfs/ramfs 上时，daemon 启动该频道缓存时会记一条警告。
    # option cache_dir '/tmp/m3u8mc'


# ============================================================
# 频道示例 1：标准模式，多镜像 + 自定义 HTTP 头
# ============================================================
config channel 'sports1'
    option enabled '1'
    option name '体育频道1'

    # 直播源，可以写多条做镜像；下载器会在这些地址间轮询/故障切换
    list url 'http://cdn1.example.com/live/sports1/index.m3u8'
    list url 'http://cdn2.example.com/live/sports1/index.m3u8'
    list url 'http://cdn3.example.com/live/sports1/index.m3u8'

    # 组播协议：rtp 或 udp
    option protocol 'rtp'
    option addr '239.1.1.1'
    option port '5004'

    # 组播从哪个网络接口/桥接口发出
    option iface 'lan'
    # 组播 TTL，多跳网络（有路由器转发）需要调大
    option ttl '4'

    # RTP/UDP 包大小（字节），一般不用改，MTU 允许范围内尽量大一点效率更高
    option pkt_size '1316'
    # 推流套接字发送缓冲（字节）。内核会把它截断到 net.core.wmem_max，
    # 配很大的值（如 41943040）时需同时执行 sysctl -w net.core.wmem_max=41943040
    option buffer_size '1048576'
    # 下载/处理用的线程数
    option threads '4'

    # 分片缓存窗口（保留最近几个 target_duration 的分片时长）
    option cache_window '3'
    # 分片缓存放哪里：memory=内存（默认，最快）；disk=本地目录（每个分片一个文件，省内存）
    # 磁盘缓存目录 = 频道 cache_dir（不填则用 global 的 cache_dir）/<频道ID>，不可写时自动回退内存
    option cache_storage 'memory'
    # option cache_dir '/mnt/sda1/m3u8mc'
    # 缓存里最多保留多少个分片
    option max_segments '5'
    # 生成给 ffmpeg 消费的内部 HLS 播放列表时，列表里放几个分片
    option hls_segments '3'

    # 1=下载缓存后转发（支持多镜像/故障切换/赛马）；0=直通模式，只能配一个 url
    option use_downloader '1'
    # 内部 HTTP server 监听端口，不写则从 http_port_base 自动分配
    # option http_port '18080'
    # 内部 HTTP server 路径前缀（本地生成的 playlist.m3u8 / 分片都挂在这个路径下）
    option http_path '/live/sports1'

    # 赛马模式：0=关闭（标准轮询/故障切换），1=开启（同时探测多个候选地址，取最快的用）
    option race_mode '0'
    # 赛马候选地址，两种写法：
    #   'IP'            —— 纯地址，Host 用 race_host 或自动推断
    #   'IP@域名'        —— 显式指定这个地址对应的 Host，多域名镜像场景精确匹配
    # list race_ip '1.2.3.4'
    # list race_ip '5.6.7.8@mirror2.example.com'
    # 赛马默认 Host（race_ip 没带 @域名 时用这个；都没配就自动从第一个镜像域名推断）
    # option race_host ''

    # 公共 HTTP 请求头，拉取列表和下载分片都会带上
    list http_header 'User-Agent: m3u8mc/1.0'
    # list http_header 'Referer: https://example.com/'

    # 只给"拉取播放列表"请求单独覆盖的头（不配置则用上面公共的 http_header）
    # list poller_http_header 'User-Agent: PlaylistFetcher/1.0'
    # 只给"下载分片"请求单独覆盖的头（不配置则用上面公共的 http_header）
    # list downloader_http_header 'User-Agent: SegmentFetcher/1.0'

    # 单独指定拉取播放列表用的地址（不配置则复用上面的 url 列表）
    # list list_url 'http://list.example.com/sports1/index.m3u8'
    # 轮询播放列表的间隔秒数（支持小数），0 表示按 target_duration 自适应
    option list_poll_interval '0'

    # 拉取播放列表 / 下载分片时使用的 HTTP 代理（留空不使用代理）
    option list_proxy ''
    option download_proxy ''

    # ffmpeg 日志（仅本频道）：
    #   ffmpeg_loglevel    传给 ffmpeg 的 -loglevel，默认 warning；可选 quiet/panic/fatal/error/warning/info/verbose/debug/trace。
    #                      error 及以下时健康的 ffmpeg 基本无输出，“日志静默 30s 视为卡死”的检测会自动关闭；
    #                      fatal 及以下还会让按日志关键字触发的重启基本失效（只剩进程退出才重启）。
    #   ffmpeg_log_forward 是否把 ffmpeg 输出逐行写入 daemon 日志（debug 级别），默认 1；
    #                      设 0 后不再写入，但 daemon 仍会读取并检查这些输出。
    # 修改这两项后该频道会重启。
    # option ffmpeg_loglevel 'warning'
    # option ffmpeg_log_forward '1'

    # 额外传给 ffmpeg 的输入参数（追加在 -i 之前）
    # list ffmpeg_input_arg '-re'
    # 额外传给 ffmpeg 的输出参数（追加在输出目标之前）
    # 注意：list 每行只能写一个值，多个参数要拆成多行，
    # 不能写成 list ffmpeg_output_arg '-c:v' 'copy'（第三个 token 会被解析器丢弃）
    # list ffmpeg_output_arg '-c:v'
    # list ffmpeg_output_arg 'copy'
    # list ffmpeg_output_arg '-c:a'
    # list ffmpeg_output_arg 'copy'


# ============================================================
# 频道示例 2：直通模式（单一源，不缓存，configuration 最简）
# ============================================================
config channel 'news1'
    option enabled '1'
    option name '新闻频道'

    # 直通模式只能配一条 url
    list url 'http://cdn.example.com/live/news1/index.m3u8'

    option protocol 'udp'
    option addr '239.1.1.2'
    option port '5004'

    option use_downloader '0'
    # 直通模式下 http_port / http_path 不生效，可以不写


# ============================================================
# 频道示例 3：赛马模式（多个候选 IP 里实时选最快的）
# ============================================================
config channel 'movie1'
    option enabled '1'
    option name '电影频道'

    list url 'http://cdn.example.com/live/movie1/index.m3u8'

    option protocol 'rtp'
    option addr '239.1.1.3'
    option port '5004'
    option iface 'lan'

    option use_downloader '1'
    option race_mode '1'
    list race_ip '10.0.0.11'
    list race_ip '10.0.0.12'
    list race_ip '10.0.0.13@backup-mirror.example.com'
    option race_host 'cdn.example.com'


# ============================================================
# 频道示例 4：默认状态下先禁用（写好配置但不自动启动）
# ============================================================
config channel 'reserve1'
    option enabled '0'
    option name '预留频道（默认不启动）'

    list url 'http://cdn.example.com/live/reserve1/index.m3u8'

    option addr '239.1.1.4'
    option port '5004'

    # 想手动拉起：先把 enabled 改成 1 并执行一次 reload，
    # 再 m3u8mcctl channel-start reserve1

    # ── ffmpeg 参数 ──────────────────────────────────────────────
    # 下面是结构化参数，不写就用括号里的默认值；写成空串（option xxx ''）表示不设置该参数。
    # 额外的自由参数用 ffmpeg_input_arg / ffmpeg_output_arg，追加在结构化参数之后。
    # option ffmpeg_re '1'                       # -re 按原始速率读取
    # option ffmpeg_input_format ''              # -f 输入格式，缓存下载器模式可填 hls
    # option ffmpeg_analyzeduration '5000000'    # -analyzeduration（微秒）
    # option ffmpeg_probesize '5000000'          # -probesize（字节）
    # option ffmpeg_copy '1'                     # -c copy，关闭会转码，路由器基本扛不住
    # option ffmpeg_annexb '0'                   # -bsf:v h264_mp4toannexb
    # option ffmpeg_pcr_period '20'              # -pcr_period（毫秒）
    # option ffmpeg_muxdelay '0.7'               # -muxdelay（秒）
    # option ffmpeg_muxrate '6M'                 # -muxrate，默认不固定码率
    # option ffmpeg_pat_period '0.5'             # -pat_period（秒）
    # option ffmpeg_sdt_period '0.5'             # -sdt_period（秒）
    # option ffmpeg_service_type 'digital_tv'    # -mpegts_service_type
    # option ffmpeg_mpegts_flags '+initial_discontinuity+resend_headers'
    # list ffmpeg_input_arg '-extension_picky'
    # list ffmpeg_input_arg '0'
