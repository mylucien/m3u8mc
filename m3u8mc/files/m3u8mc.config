# /etc/config/m3u8mc
# m3u8mc 插件 UCI 配置文件
#
# 格式说明见设计文档 2.2 节。
# 修改后执行 service m3u8mc reload 即可热加载，无需重启。

config global
    option enabled      '1'
    option log_level    'warning'
    # 控制 socket 路径；m3u8mcctl 默认值与此保持一致
    option control_socket '/var/run/m3u8mcd.sock'
    # 内部 HTTP 端口起始值；频道按此递增自动分配
    option http_port_base '18080'
    # 自定义 ffmpeg 可执行文件路径；留空则使用系统 PATH 中的 ffmpeg（通常是 opkg 精简版）。
    # 建议通过 LuCI「服务→m3u8mc 转播→FFmpeg 管理」页面的下载功能自动设置该项，
    # 而不要手动填写（该页面会先校验二进制可用性再写入 UCI 并热重载）。
    # option ffmpeg_bin '/usr/local/bin/ffmpeg'
    # ffmpeg 静态构建下载地址（按 CPU 架构），为空时使用内置默认值。
    # 可通过 LuCI「服务→m3u8mc 转播→全局设置」页面修改。
    # option ffmpeg_download_url_x86_64  'https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz'
    # option ffmpeg_download_url_aarch64 'https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-arm64-static.tar.xz'
    # option ffmpeg_download_url_armv7l  'https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-armhf-static.tar.xz'
    # option ffmpeg_download_url_i686    'https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-i686-static.tar.xz'

# -----------------------------------------------
# 频道示例（复制并修改 section name 来添加新频道）
# -----------------------------------------------

# config channel 'cctv5'
#     option enabled      '1'
#     option name         'CCTV-5 体育'
#     # 多个 url 为镜像服务器，轮询或赛马模式选用
#     list   url          'http://mirror1.example.com/cctv5/playlist.m3u8'
#     list   url          'http://mirror2.example.com/cctv5/playlist.m3u8'
#     option protocol     'udp'       # udp | rtp
#     option addr         '239.1.1.1'
#     option port         '5001'
#     option iface        'lan'       # OpenWrt 接口名，或直接填本机 IP
#     option ttl          '4'
#     option pkt_size     '1316'
#     option threads      '4'         # 分块下载并发数
#     option cache_window '3'         # 缓存时间窗口 = 分片时长 × cache_window
#     option max_segments '5'         # 缓存分片数上限
#     option hls_segments '3'         # 生成内部 m3u8 的滑动窗口分片数
#     option use_downloader '1'       # 1=标准模式(拉取缓存转发) 0=直通模式
#     option race_mode    '0'         # 1=赛马模式(多镜像并发竞速取最快)
#     # 直通模式（use_downloader=0）下 ffmpeg 直接拉上游，仅允许单条 url
#     # list   url        'http://single-source.example.com/live.m3u8'

# -----------------------------------------------
# 网络隔离（可选）
# -----------------------------------------------

# config vlan_isolation
#     option enabled      '0'
#     option base_device  'br-lan'
#     option vlan_id      '100'
#     option ipaddr       '10.10.100.1'
#     option netmask      '255.255.255.0'
